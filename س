@bot.message_handler(
    func=lambda m: True,
    content_types=["text"],
)
def messages(message):
    user = message.from_user
    uid = user.id
    text = message.text.strip()

    mode = load(
        "mode",
        "admin_only",
    )

    if (
        mode == "admin_only"
        and not is_admin(user)
    ):
        return deny(
            message.chat.id
        )

    current = states.get(uid)

    if current == "channel":
        value = (
            text
            if text.startswith("@")
            else "@" + text
        )

        items = load(
            "channels",
            [],
        )

        if value not in items:
            items.append(value)

        save(
            "channels",
            items,
        )

        states.pop(
            uid,
            None,
        )

        bot.send_message(
            message.chat.id,
            f"✅ تمت إضافة القناة: {value}",
        )

        return

    if current == "remove_channel":
        items = load(
            "channels",
            [],
        )

        if text in items:
            items.remove(text)

            save(
                "channels",
                items,
            )

            states.pop(
                uid,
                None,
            )

            bot.send_message(
                message.chat.id,
                f"✅ تم إزالة القناة: {text}",
            )

        else:
            bot.reply_to(
                message,
                "⚠️ القناة غير موجودة في القائمة، "
                "أرسل المعرف بشكل صحيح:",
            )

        return

    if current == "forced_add":
        value = (
            text
            if text.startswith("@")
            else "@" + text
        )

        try:
            bot_member = bot.get_chat_member(
                value,
                bot.get_me().id,
            )

            if bot_member.status not in [
                "administrator",
                "creator",
            ]:
                bot.reply_to(
                    message,
                    f"❌ البوت ليس مشرفاً في القناة {value}!\n"
                    "الرجاء رفع البوت مشرفاً أولاً "
                    "ثم إعادة إرسال المعرف:",
                )

                return

        except Exception as e:
            bot.reply_to(
                message,
                "❌ تأكد من أن القناة عامة "
                "(`@username`) وأن البوت مشرف "
                f"فيها بشكل صحيح.\nخطأ: {e}",
            )

            return

        items = load(
            "forced_channels",
            [],
        )

        if value not in items:
            items.append(value)

        save(
            "forced_channels",
            items,
        )

        states.pop(
            uid,
            None,
        )

        bot.send_message(
            message.chat.id,
            "✅ تمت إضافة قناة الاشتراك "
            f"الإجباري بنجاح: {value}",
        )

        return

    if current == "forced_remove":
        value = (
            text
            if text.startswith("@")
            else "@" + text
        )

        items = load(
            "forced_channels",
            [],
        )

        if value in items:
            items.remove(value)

            save(
                "forced_channels",
                items,
            )

            states.pop(
                uid,
                None,
            )

            bot.send_message(
                message.chat.id,
                "✅ تم إزالة القناة من "
                f"الاشتراكات الإجبارية: {value}",
            )

        else:
            bot.reply_to(
                message,
                "⚠️ القناة غير مسجلة، "
                "أرسل المعرف الصحيح:",
            )

        return

    if current == "timer":
        try:
            value = int(text)

            if value < 1:
                raise ValueError

            save(
                "timer",
                value,
            )

            states.pop(
                uid,
                None,
            )

            bot.send_message(
                message.chat.id,
                f"✅ تم تحديث المؤقت إلى: "
                f"{value} دقيقة",
            )

        except ValueError:
            bot.reply_to(
                message,
                "أرسل رقمًا صحيحًا أكبر من 0 "
                "مثل 3",
            )

        return

    if current == "button":
        parts = [
            x.strip()
            for x in text.split(
                "|",
                1,
            )
        ]

        if len(parts) != 2:
            return bot.reply_to(
                message,
                "أرسل اسم الزر والمعرف بهذا الشكل:\n"
                "👤 المطور | @sn3nn",
            )

        target = parts[1]

        url = (
            target
            if target.startswith(
                "https://t.me/"
            )
            else f"https://t.me/"
            f"{target.lstrip('@')}"
        )

        save(
            "button",
            {
                "text": parts[0],
                "url": url,
            },
        )

        states.pop(
            uid,
            None,
        )

        bot.send_message(
            message.chat.id,
            "✅ تم تعديل زر المطور بنجاح",
        )

        return

