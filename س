@bot.message_handler(
    commands=[
        "start",
        "ping",
        "prices",
        "id",
        "stats",
        "help",
    ]
)
def commands(message):
    user = message.from_user

    mode = load(
        "mode",
        "admin_only",
    )

    if (
        mode == "admin_only"
        and not is_admin(user)
    ):
        return deny(
            message.chat.id
        )

    if not is_admin(user):
        is_subbed, missing = (
            check_user_forced_subscriptions(
                user.id
            )
        )

        if not is_subbed:
            markup = InlineKeyboardMarkup(
                row_width=1
            )

            for ch in missing:
                target_url = (
                    f"https://t.me/"
                    f"{ch.lstrip('@')}"
                )

                markup.add(
                    InlineKeyboardButton(
                        f"📢 اشترك في القناة: {ch}",
                        url=target_url,
                    )
                )

            markup.add(
                InlineKeyboardButton(
                    "🔄 تحقق من الاشتراك",
                    callback_data="check_sub",
                )
            )

            bot.send_message(
                message.chat.id,
                "⚠️ عذراً، يجب عليك الاشتراك "
                "في القناة التالية لكي تتمكن "
                "من استخدام البوت:",
                reply_markup=markup,
            )

            return

    command = (
        message.text
        .split()[0]
        .split("@")[0]
    )

    if command == "/start":
        users = load(
            "users",
            [],
        )

        is_new = (
            user.id not in users
        )

        if is_new:
            users.append(user.id)
            save(
                "users",
                users,
            )

            if (
                load(
                    "notifications",
                    "enabled",
                )
                == "enabled"
            ):
                notif_text = (
                    "🔔 مستخدم جديد قام "
                    "بتفعيل البوت!\n\n"
                    f"👤 الاسم: {user.first_name}\n"
                    f"🆔 الآيدي: `{user.id}`\n"
                    f"🌐 اليوزر: "
                    f"@{user.username if user.username else 'لا يوجد'}"
                )

                try:
                    bot.send_message(
                        OWNER_ID,
                        notif_text,
                        parse_mode="Markdown",
                    )

                except Exception as e:
                    log.error(
                        "Failed to send notification "
                        "to owner: %s",
                        e,
                    )

        clear_kb = bot.send_message(
            message.chat.id,
            "جاري تحميل لوحة التحكم...",
            reply_markup=ReplyKeyboardRemove(),
        )

        try:
            bot.delete_message(
                message.chat.id,
                clear_kb.message_id,
            )

        except Exception:
            pass

        if is_admin(user):
            bot.send_message(
                message.chat.id,
                "🛠️ لوحة التحكم الإدارية:",
                reply_markup=panel(user),
            )

        else:
            bot.send_message(
                message.chat.id,
                "أهلاً بك عزيزي المستخدم.",
            )

    elif command == "/ping":
        bot.reply_to(
            message,
            "البوت يعمل ✅",
        )

    elif command == "/prices":
        bot.send_message(
            message.chat.id,
            price_text(),
            reply_markup=developer_markup(),
        )

    elif command == "/id":
        bot.reply_to(
            message,
            f"🆔 آيديك: {user.id}",
        )

    elif command == "/stats":
        bot.reply_to(
            message,
            f"المستخدمون: "
            f"{len(load('users', []))}\n"
            f"القنوات: {len(channels())}",
        )

    else:
        bot.reply_to(
            message,
            "استخدم الأوامر المتاحة أو /start",
        )


