        "timer": "3",
        "auto": "enabled",
        "developer": "المطور",
        "welcome": "أهلاً بك في بوت أسعار TON 💎",
        "mode": "admin_only",
        "notifications": "enabled",
    }

    for key, value in default_values.items():
        if key == "mode" or not os.path.exists(FILES[key]):
            save(key, value)

    for key in (
        "channels",
        "admins",
        "users",
        "blocked",
        "forced_channels",
    ):
        if not os.path.exists(FILES[key]):
            save(key, [])

    if not os.path.exists(FILES["button"]):
        save("button", DEFAULT_BUTTON)

    if not os.path.exists(FILES["channel_button"]):
        save("channel_button", DEFAULT_CHANNEL_BUTTON)


