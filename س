def is_admin(user):
    username = (
        getattr(user, "username", "") or ""
    ).lower().lstrip("@")

    admins = [
        str(x).lower().lstrip("@")
        for x in load("admins", [])
    ]

    return bool(
        user
        and (
            user.id == OWNER_ID
            or username == OWNER_USERNAME.lower()
            or username in admins
        )
    )


def is_owner(user):
    return bool(user and user.id == OWNER_ID)


