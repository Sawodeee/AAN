            "✅ تم الحفظ بنجاح",
        )

        return

    if current == "block":
        try:
            value = int(text)

        except ValueError:
            return bot.reply_to(
                message,
                "أرسل آيدي رقمي صحيح للمستخدم",
            )

        blocked = load(
            "blocked",
            [],
        )

        if value in blocked:
            blocked.remove(value)
            result = "إلغاء حظر"

        else:
            blocked.append(value)
            result = "تم حظر"

        save(
            "blocked",
            blocked,
        )

        states.pop(
            uid,
            None,
        )

        bot.send_message(
            message.chat.id,
