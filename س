# ============================================================
# FORCED SUBSCRIPTION
# ============================================================

def check_user_forced_subscriptions(user_id):
    forced_items = load(
        "forced_channels",
        [],
    )

    if not forced_items:
        return True, []

    not_subscribed = []

    for item in forced_items:
        item = item.strip()

        try:
            chat_target = (
                item
                if item.startswith("@")
                else "@" + item
            )

            member = bot.get_chat_member(
                chat_target,
                user_id,
            )

            if member.status not in [
                "creator",
                "administrator",
                "member",
            ]:
                not_subscribed.append(
                    chat_target
                )

        except Exception as exc:
            log.error(
                "check sub error for %s: %s",
                item,
                exc,
            )

            not_subscribed.append(item)

    return (
        len(not_subscribed) == 0,
        not_subscribed,
    )


