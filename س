        parts = [
            x.strip()
            for x in text.split(
                "|",
                1,
            )
        ]

        if len(parts) != 2:
            return bot.reply_to(
                message,
                "أرسل اسم الزر والرابط بهذا الشكل:\n"
                "📢 قناتنا | https://t.me/your_channel",
            )

        target = parts[1]

        url = (
            target
            if target.startswith(
                "https://t.me/"
            )
            else f"https://t.me/"
            f"{target.lstrip('@')}"
        )

        save(
            "channel_button",
            {
                "text": parts[0],
                "url": url,
