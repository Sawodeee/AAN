# ============================================================
# PRICE SOURCE 1 - COINEX
# ============================================================

def _price_from_coinex():
    """
    المصدر الأول:
    CoinEx TON/USDT
    """

    url = "https://api.coinex.com/v2/spot/ticker"

    response = _http_session.get(
        url,
        params={
            "market": "TONUSDT",
        },
        headers=HTTP_HEADERS,
        timeout=(5, 10),
    )

    response.raise_for_status()

    payload = response.json()

    if payload.get("code") != 0:
        raise RuntimeError(
            "CoinEx API error: "
            f"{payload.get('message', 'unknown error')}"
        )

    data = payload.get("data")

    if not isinstance(data, list) or not data:
        raise ValueError(
            "CoinEx returned empty ticker data"
        )

    for ticker in data:
        if str(ticker.get("market", "")).upper() == "TONUSDT":
            price = float(ticker.get("last", 0))

            if price <= 0:
                raise ValueError(
                    "CoinEx returned invalid TON price"
                )

            return price

    raise ValueError(
        "TONUSDT was not returned by CoinEx"
    )


# ============================================================
# PRICE SOURCE 2 - COINGECKO
# ============================================================

def _price_from_coingecko():
    """
    المصدر الثاني:
    CoinGecko

    إذا وضعت COINGECKO_API_KEY في Railway
    سيتم استخدامه تلقائياً.
    """

    url = (
        "https://api.coingecko.com/api/v3/simple/price"
    )

    headers = dict(HTTP_HEADERS)

    coingecko_key = os.getenv(
        "COINGECKO_API_KEY",
        "",
    ).strip()

    if coingecko_key:
        headers["x-cg-demo-api-key"] = coingecko_key

    response = _http_session.get(
        url,
        params={
            "ids": "the-open-network",
            "vs_currencies": "usd",
        },
        headers=headers,
        timeout=(5, 10),
    )

    response.raise_for_status()

    payload = response.json()

    price = float(
        payload
        .get("the-open-network", {})
        .get("usd", 0)
    )

    if price <= 0:
        raise ValueError(
            "CoinGecko returned invalid TON price"
        )

    return price


# ============================================================
# PRICE SOURCE 3 - KRAKEN
# ============================================================

def _price_from_kraken():
    """
    المصدر الثالث:
    Kraken TON/USD

    إذا لم يكن الزوج متاحاً أو رفضت Kraken الطلب،
    سيتم الانتقال للسعر المخزن سابقاً.
    """

    url = "https://api.kraken.com/0/public/Ticker"

    response = _http_session.get(
        url,
        params={
            "pair": "TONUSD",
        },
        headers=HTTP_HEADERS,
        timeout=(5, 10),
    )

    response.raise_for_status()

    payload = response.json()

    errors = payload.get("error", [])

    if errors:
        raise RuntimeError(
            "Kraken API error: "
            + ", ".join(map(str, errors))
        )

    result = payload.get("result", {})

    if not isinstance(result, dict) or not result:
        raise ValueError(
            "Kraken returned empty ticker data"
        )

    for ticker in result.values():
        last_trade = ticker.get("c")

        if (
            isinstance(last_trade, list)
            and last_trade
        ):
            price = float(last_trade[0])

            if price > 0:
                return price

    raise ValueError(
        "Kraken returned invalid TON price"
    )


# ============================================================
# MAIN PRICE FUNCTION
# ============================================================

def ton_price():
    """
    جلب سعر TON من 3 مصادر:

    1. CoinEx
    2. CoinGecko
    3. Kraken

    وإذا فشلت كلها:
    يستخدم آخر سعر صحيح مخزن.
    """

    global _last_ton_price
    global _last_price_time

    now = time.time()

    # --------------------------------------------------------
    # Cache
    # --------------------------------------------------------

    if (
        _last_ton_price > 0
        and now - _last_price_time
        < PRICE_CACHE_SECONDS
    ):
        return _last_ton_price

    # --------------------------------------------------------
    # المصدر الأول: CoinEx
    # --------------------------------------------------------

    try:
        price = _price_from_coinex()

        _last_ton_price = price
        _last_price_time = now

        log.info(
            "TON price source=CoinEx price=%.6f",
            price,
        )

        return price

    except Exception as exc:
        log.warning(
            "CoinEx price failed: %s",
            exc,
        )

    # --------------------------------------------------------
    # المصدر الثاني: CoinGecko
    # --------------------------------------------------------

    try:
        price = _price_from_coingecko()

        _last_ton_price = price
        _last_price_time = now

        log.info(
            "TON price source=CoinGecko price=%.6f",
            price,
        )

        return price

    except Exception as exc:
        log.warning(
            "CoinGecko price failed: %s",
            exc,
        )

    # --------------------------------------------------------
    # المصدر الثالث: Kraken
    # --------------------------------------------------------

    try:
        price = _price_from_kraken()

        _last_ton_price = price
        _last_price_time = now

        log.info(
            "TON price source=Kraken price=%.6f",
            price,
        )

        return price

    except Exception as exc:
        log.warning(
            "Kraken price failed: %s",
            exc,
        )

    # --------------------------------------------------------
    # آخر سعر صحيح
    # --------------------------------------------------------

    if _last_ton_price > 0:
        log.warning(
            "All TON price sources failed. "
            "Using cached price=%.6f",
            _last_ton_price,
        )

        return _last_ton_price

    log.error(
        "All TON price sources failed "
        "and no cached price exists."
    )

    return 0.0


