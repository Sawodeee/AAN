# ============================================================
# FILE FUNCTIONS
# ============================================================

def load(key, default):
    try:
        path = FILES[key]

        if not os.path.exists(path):
            return default

        with open(path, encoding="utf-8") as f:
            if path.endswith(".json"):
                return json.load(f)

            return f.read().strip()

    except Exception as exc:
        log.error("load %s: %s", key, exc)
        return default


def save(key, value):
    try:
        path = FILES[key]

        with open(path, "w", encoding="utf-8") as f:
            if path.endswith(".json"):
                json.dump(
                    value,
                    f,
                    ensure_ascii=False,
                    indent=2,
                )
            else:
                f.write(str(value))

        return True

    except Exception as exc:
        log.error("save %s: %s", key, exc)
        return False


def defaults():
